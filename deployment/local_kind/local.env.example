# cp local.env.example local.env 후 값을 채웁니다. local.env는 git에 올라가지 않습니다.
# 비밀은 값이 아니라 파일 경로로만 적습니다.

# 실험 대상 저장소. 공개 저장소여야 A안(토큰 없는 clone) 비교가 의미가 있습니다.
GITHUB_REPOSITORY=bbungjun/Autoresearch

# 이 저장소에 설치된 GitHub App. 권한: Contents read/write, Issues read, Metadata read.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# `codex login`으로 만들어진 인증 파일. 로컬 클러스터의 Secret으로만 들어갑니다.
CODEX_AUTH_JSON_PATH=${HOME}/.codex/auth.json

# 보통 바꿀 필요 없음
CLUSTER_NAME=autoresearch-local
REGISTRY_PORT=5001
